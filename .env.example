# CivicOS configuration.
# Copy to .env and edit. Every value below is a default that works out of the
# box, except the secret key, which you MUST change before any real deployment.
#
# Nested settings use a double underscore: CIVICOS_<GROUP>__<FIELD>.

# ---------------------------------------------------------------- general ---
CIVICOS_ENVIRONMENT=local              # local | test | staging | production
CIVICOS_DEBUG=false
CIVICOS_API_V1_PREFIX=/api/v1
CIVICOS_DOCS_ENABLED=true
CIVICOS_TIMEZONE=UTC
CIVICOS_DEFAULT_LANGUAGE=en
CIVICOS_SUPPORTED_LANGUAGES=en

# --------------------------------------------------------------- security ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
CIVICOS_SECURITY__SECRET_KEY=change-me-to-a-long-random-value-before-deploying
CIVICOS_SECURITY__ACCESS_TOKEN_TTL_MINUTES=30
CIVICOS_SECURITY__REFRESH_TOKEN_TTL_DAYS=14
CIVICOS_SECURITY__PASSWORD_MIN_LENGTH=10
# Allow residents to report without an account. Turning this off will reduce
# the number of reports you receive; that is the trade-off.
CIVICOS_SECURITY__ALLOW_ANONYMOUS_REPORTS=true

# --------------------------------------------------------------- database ---
# SQLite runs the whole platform with no server. Use PostgreSQL in production.
CIVICOS_DATABASE__URL=sqlite+aiosqlite:///./var/civicos.db
# CIVICOS_DATABASE__URL=postgresql+asyncpg://civicos:civicos@localhost:5432/civicos
CIVICOS_DATABASE__ECHO=false
CIVICOS_DATABASE__POOL_SIZE=10

# --------------------------------------------------------------- tenancy ----
# How a request is mapped to a municipality, in order of precedence.
CIVICOS_TENANCY__RESOLUTION_ORDER=jwt,header,subdomain,default
CIVICOS_TENANCY__HEADER_NAME=X-Tenant
CIVICOS_TENANCY__DEFAULT_TENANT_SLUG=demo
# Set to serve each municipality on its own subdomain, e.g. northtown.civicos.gov
# CIVICOS_TENANCY__BASE_DOMAIN=civicos.gov

# --------------------------------------------------------------------- AI ---
# 'mock' is the offline, rule-based provider: no key, no network, no cost.
# The platform stays fully functional on it, just without model intelligence.
CIVICOS_AI__PROVIDER=mock              # anthropic | google | openai | mock
CIVICOS_AI__CHAT_MODEL=claude-opus-5
CIVICOS_AI__FAST_MODEL=claude-haiku-4-5
# CIVICOS_AI__ANTHROPIC_API_KEY=sk-ant-...
# CIVICOS_AI__GOOGLE_API_KEY=...
# CIVICOS_AI__OPENAI_API_KEY=sk-...

# Run vision or embeddings on a different vendor from chat if you want to.
CIVICOS_AI__VISION_PROVIDER=default
CIVICOS_AI__EMBEDDING_PROVIDER=default
CIVICOS_AI__EMBEDDING_MODEL=text-embedding-3-small
CIVICOS_AI__EMBEDDING_DIMENSIONS=1536

# Spend guardrails. On exhaustion the platform degrades to rules, it does not
# stop accepting reports.
CIVICOS_AI__DAILY_TOKEN_BUDGET=2000000
CIVICOS_AI__MAX_IMAGES_PER_REQUEST=8
CIVICOS_AI__REQUEST_TIMEOUT_SECONDS=60

# -------------------------------------------------------------------- RAG ---
CIVICOS_RAG__CHUNK_SIZE=1200
CIVICOS_RAG__CHUNK_OVERLAP=180
CIVICOS_RAG__TOP_K=6
CIVICOS_RAG__VECTOR_BACKEND=auto       # auto | pgvector | numpy
CIVICOS_RAG__KEYWORD_WEIGHT=0.35

# ---------------------------------------------------------------- storage ---
CIVICOS_STORAGE__BACKEND=local         # local | s3
CIVICOS_STORAGE__MAX_UPLOAD_BYTES=26214400
# CIVICOS_STORAGE__S3_BUCKET=civicos-uploads
# CIVICOS_STORAGE__S3_REGION=eu-west-1
# CIVICOS_STORAGE__S3_ENDPOINT_URL=https://minio.internal:9000

# ---------------------------------------------------------- notifications ---
# 'console' writes to the log - a complete, working pipeline with no vendor.
CIVICOS_NOTIFICATIONS__SMS_BACKEND=console      # console | twilio | webhook | disabled
CIVICOS_NOTIFICATIONS__EMAIL_BACKEND=console    # console | smtp | disabled
CIVICOS_NOTIFICATIONS__WHATSAPP_BACKEND=disabled
# CIVICOS_NOTIFICATIONS__TWILIO_ACCOUNT_SID=
# CIVICOS_NOTIFICATIONS__TWILIO_AUTH_TOKEN=
# CIVICOS_NOTIFICATIONS__TWILIO_FROM_NUMBER=
# CIVICOS_NOTIFICATIONS__WEBHOOK_URL=https://sms-gateway.internal/send
# CIVICOS_NOTIFICATIONS__SMTP_HOST=smtp.internal
# CIVICOS_NOTIFICATIONS__SMTP_FROM=no-reply@municipality.gov

# ------------------------------------------------------------------ redis ---
# Optional. Enables cross-replica rate limiting and a job queue.
# CIVICOS_REDIS__URL=redis://localhost:6379/0

# ------------------------------------------------------------- rate limits ---
CIVICOS_RATE_LIMIT__ENABLED=true
CIVICOS_RATE_LIMIT__DEFAULT_PER_MINUTE=120
CIVICOS_RATE_LIMIT__ANONYMOUS_PER_MINUTE=30
CIVICOS_RATE_LIMIT__AI_PER_MINUTE=20

# ------------------------------------------------------------------- CORS ---
# Must list explicit origins in production; '*' is refused there.
CIVICOS_CORS__ALLOW_ORIGINS=http://localhost:3000

# ---------------------------------------------------------- observability ---
CIVICOS_OBSERVABILITY__LOG_LEVEL=INFO
CIVICOS_OBSERVABILITY__LOG_FORMAT=console      # console | json (use json in prod)
CIVICOS_OBSERVABILITY__METRICS_ENABLED=true
CIVICOS_OBSERVABILITY__TRACING_ENABLED=false
# CIVICOS_OBSERVABILITY__OTLP_ENDPOINT=http://tempo:4318/v1/traces

# -------------------------------------------------------------------- geo ---
CIVICOS_GEO__DUPLICATE_RADIUS_METERS=120
CIVICOS_GEO__DUPLICATE_TIME_WINDOW_HOURS=168
CIVICOS_GEO__HOTSPOT_CELL_METERS=250
